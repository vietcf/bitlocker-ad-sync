{
  // Lab: DC01.example.local (192.168.11.129) over plain LDAP (389) with Negotiate (NTLM/Kerberos),
  // which signs and encrypts the session, so the password and keys do not travel in clear.
  // To go back to the offline sample data: set "Source": "JsonFile".
  "Ldap": {
    "Source": "Ldap",
    "JsonFilePath": "sample-directory.json",
    "Servers": [ "192.168.11.129" ],
    "Protocol": "Ldap",
    "Auth": "Negotiate",
    "Username": "EXAMPLE\\sp_admin",
    // Fill in yourself. Best: run `BitlockerSync.Worker protect "<password>"` and paste the dpapi:... value.
    "Password": "Hochiminh@2001Hochiminh@2001",
    "BaseDn": "DC=example,DC=local",
    // [] = doc ca domain (lab). Gioi han OU, vi du cho lab nay (moi OU phai nam trong BaseDn):
    //   "SearchBases": [ "OU=Computers,OU=HO,DC=example,DC=local", "OU=Domain Controllers,DC=example,DC=local" ]
    // Sua xong chay: dotnet run -- check  -> moi OU mot dong OK / FAIL. Quy tac day du: appsettings.json.
    "SearchBases": [],
    "TimeoutSeconds": 30
  },
  "Ingest": {
    // HTTPS qua nginx (docker compose). CA dev do cert/generate-self-signed.sh tao; duong dan tuong doi
    // tinh tu thu muc chua file chay (bin/Debug/net10.0/win-x64) ve thu muc cert o goc repo.
    "BaseUrl": "https://localhost:8443/api/ingest",
    "CaFile": "../../../../../../../cert/ca.crt",
    // Matches INGEST_API_KEY in server/.env, encrypted for this machine (DPAPI).
    "ApiKey": "dpapi:",
    "RetryForMinutes": 1
  },
  "Schedule": {
    "DeltaEveryMinutes": 2,
    "HeartbeatEveryMinutes": 1,
    "StateFile": "state.dev.json"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
