{
  // =====================================================================================================
  // BitlockerSync.Worker (.NET, Windows) - CAU HINH PRODUCTION. Sua file nay trong thu muc cai
  // (C:\BitlockerSync\appsettings.json). Huong dan: README muc 4.4. JSON cho phep comment.
  //
  // ---------------------------------------------- VI DU -----------------------------------------------
  // Domain corp.local, service chay bang gMSA (Username/Password de trong), tai khoan chi duoc cap
  // quyen doc OU may tinh cua 3 chi nhanh:
  //
  //   "Servers":     [ "dc01.corp.local", "dc02.corp.local" ]
  //   "Protocol":    "Ldaps",   "Auth": "Negotiate",   "Username": "",   "Password": ""
  //   "BaseDn":      "DC=corp,DC=local"
  //   "SearchBases": [
  //     "OU=Computers,OU=HO,DC=corp,DC=local",
  //     "OU=Computers,OU=HN,DC=corp,DC=local",
  //     "OU=Computers,OU=HCM,DC=corp,DC=local"
  //   ]
  //
  // Khong dung gMSA: "Username": "CORP\\svc-blk" (trong JSON viet \\), "Password": "dpapi:..."
  //
  // Quy tac SearchBases:
  //   - [] (rong) = doc toan bo BaseDn. Chi dung khi tai khoan doc duoc key tren ca domain.
  //   - Moi OU la DN day du va PHAI nam trong BaseDn (cung phan DC=...), neu khong service khong khoi dong.
  //     Sai:  BaseDn "DC=corp,DC=local" + SearchBases "OU=HO,DC=example,DC=local"
  //   - Phai phu het OU goc cua moi chi nhanh trong app (Quan tri > Chi nhanh & OU); may nam ngoai
  //     SearchBases bi gan nhan "Khong con trong AD" sau luot full.
  //   - Moi OU phai duoc cap quyen doc key (README muc 4.1); OU khong doc duoc lam dung ca luot
  //     (ldap_search_base_failed). Sua xong chay: BitlockerSync.Worker.exe check -> moi OU mot dong OK / FAIL.
  //
  // Bi mat (Ldap:Password, Ingest:ApiKey): gia tri "dpapi:..." tao tren chinh may chu nay bang
  //   BitlockerSync.Worker.exe protect      (nhap bi mat o dau nhac an)
  // =====================================================================================================
  "Ldap": {
    "Source": "Ldap",
    // Tried in order: the first is the pinned DC, the others are fallbacks (a switch forces a full run).
    // Vi du: [ "dc01.corp.local" ] | [ "dc01.corp.local", "dc02.corp.local" ]
    "Servers": [ "dc01.corp.local", "dc02.corp.local" ],
    // Ldaps (636, recommended) | StartTls (389 + TLS) | Ldap (389; with Negotiate, Kerberos signing+sealing)
    "Protocol": "Ldaps",
    // Negotiate = the account the service runs as (gMSA), or Username/Password below.
    // Basic = simple bind with Username/Password (refused over plain Ldap unless AllowInsecure).
    "Auth": "Negotiate",
    // Vi du: "" (gMSA) | "CORP\\svc-blk" | "svc-blk@corp.local"
    "Username": "",
    // Vi du: "" (gMSA) | "dpapi:AQAAANCMnd8B..." (tu lenh protect)
    "Password": "",
    // Vi du: "DC=corp,DC=local" (domain corp.local)
    "BaseDn": "DC=corp,DC=local",
    // Empty = the whole BaseDn. Otherwise only these OUs. Xem quy tac va vi du o dau file.
    "SearchBases": [],
    "PageSize": 1000,
    "TimeoutSeconds": 60,
    "AllowInsecure": false,
    "SkipCertificateValidation": false
  },
  "Ingest": {
    "BaseUrl": "https://blk.corp.local:8443/api/ingest",
    // Xac thuc: chi API key (INGEST_API_KEY trong server/.env), dang "dpapi:..." tu lenh protect,
    // gui qua HTTPS; server con kiem tra IP worker (INGEST_ALLOWED_IPS).
    "ApiKey": "",
    // File PEM cua CA cap chung chi HTTPS cho server, neu Windows chua tin CA do.
    // Vi du: "C:\\BitlockerSync\\corp-ca.pem" | "" (chung chi da duoc Windows tin)
    "CaFile": "",
    "TimeoutSeconds": 60,
    "BatchSize": 500,
    "RetryForMinutes": 60,
    // Tat kiem tra chung chi HTTPS cua server: true = chap nhan MOI chung chi (tu ky, sai ten, het han).
    // Van ma hoa, nhung khong phat hien duoc server gia -> chi dung cho lab / chung chi tu ky khi chua co CaFile.
    // Uu tien dung CaFile (tin dung CA tu ky) thay vi tat kiem tra. Bat thi worker ghi canh bao vao log.
    // Vi du: false (mac dinh, production) | true (lab)
    "SkipCertificateValidation": false
  },
  "Schedule": {
    "DeltaEveryMinutes": 15,
    "FullAt": "01:00",
    "HeartbeatEveryMinutes": 5,
    "WorkerId": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    },
    "EventLog": {
      "SourceName": "BitlockerSync",
      "LogLevel": { "Default": "Information" }
    }
  }
}
