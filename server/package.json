{
  "name": "bitlocker-management-server",
  "version": "2.11.5",
  "private": true,
  "description": "BitLocker recovery key management: web API + ingest API",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node --env-file=.env src/index.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "seed:dev": "node --env-file=.env src/db/seed-dev.js",
    "users": "node --env-file=.env src/cli/users.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ldapts": "^9.2.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
