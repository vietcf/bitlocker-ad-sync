<%- include('../partials/head') %>
<section class="card narrow">
  <h1><%= t('Đăng nhập') %></h1>
  <p class="muted"><%= t('Quản lý BitLocker recovery key') %></p>
  <% if (expired && !error) { %><div class="notice notice-info" role="status"><%= t('Phiên đăng nhập đã hết hạn (không hoạt động quá lâu hoặc quá thời gian tối đa). Đăng nhập lại để tiếp tục.') %></div><% } %>
  <%- include('../partials/error-box', { error }) %>
  <form method="post" action="/login" class="form">
    <%- include('../partials/csrf') %>
    <input type="hidden" name="next" value="<%= next %>">
    <label><%= t('Tên đăng nhập') %> <input name="username" value="<%= username %>" autocomplete="username" required autofocus
             placeholder="<%= ldapEnabled ? t('tài khoản Windows, ví dụ nguyenvana') : '' %>">
    </label>
    <label><%= t('Mật khẩu') %> <input name="password" type="password" autocomplete="current-password" required>
    </label>
    <button type="submit"><%= t('Đăng nhập') %></button>
  </form>
  <% if (ldapEnabled) { %>
    <p class="muted small"><%= t('Dùng tài khoản và mật khẩu Windows (AD). Chỉ tài khoản đã được Admin HQ tạo trong hệ thống mới đăng nhập được.') %></p>
  <% } %>
</section>
<%- include('../partials/foot') %>
