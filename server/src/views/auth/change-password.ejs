<%- include('../partials/head') %>
<section class="card narrow">
  <h1>Đổi mật khẩu</h1>
  <% if (me.mustChangePassword) { %>
    <p>Bạn cần đổi mật khẩu trước khi tiếp tục.</p>
  <% } %>
  <p class="muted"><%= policyText %> Nên dùng một cụm từ dài.</p>
  <%- include('../partials/error-box', { error }) %>
  <form method="post" action="/change-password" class="form">
    <%- include('../partials/csrf') %>
    <label>Mật khẩu hiện tại
      <input name="currentPassword" type="password" autocomplete="current-password" required>
    </label>
    <label>Mật khẩu mới
      <input name="newPassword" type="password" autocomplete="new-password" minlength="<%= policy.minLength %>" required>
    </label>
    <label>Nhập lại mật khẩu mới
      <input name="confirm" type="password" autocomplete="new-password" minlength="<%= policy.minLength %>" required>
    </label>
    <div class="actions">
      <button type="submit">Đổi mật khẩu</button>
      <% if (!me.mustChangePassword) { %><a href="/" class="button secondary">Hủy</a><% } %>
    </div>
  </form>
  <% if (me.mustChangePassword) { %>
    <form method="post" action="/logout" class="inline">
      <%- include('../partials/csrf') %>
      <button type="submit" class="link">Đăng xuất</button>
    </form>
  <% } %>
</section>
<%- include('../partials/foot') %>
