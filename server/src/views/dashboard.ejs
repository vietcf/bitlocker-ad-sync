<%- include('partials/head') %>
<div class="title-row">
  <h1><%= t('Tổng quan') %></h1>
  <span class="muted"><%= t('Số liệu trong phạm vi chi nhánh của bạn') %></span>
</div>

<p class="freshness muted">
  <% if (freshness.lastSyncAt) { %>
    <%- th('Dữ liệu cập nhật lần cuối lúc <strong>{at}</strong> ({ago}, lượt đồng bộ AD thành công gần nhất).', { at: h.dateTime(freshness.lastSyncAt), ago: freshness.ageMinutes < 1 ? t('vừa xong') : t('{n} phút trước', { n: h.number(freshness.ageMinutes) }) }) %>
  <% } else { %> <%= t('Chưa có lượt đồng bộ AD nào thành công.') %> <% } %>
</p>
<% if (freshness.stale) { %>
  <div class="notice notice-warn" role="status">
    <% if (freshness.lastSyncAt) { %>
      <%= t('Đồng bộ AD đã quá {min} phút chưa chạy thành công: key và máy tạo trên AD sau {at} có thể chưa có trong hệ thống.', { min: freshness.maxMinutes, at: h.dateTime(freshness.lastSyncAt) }) %>
    <% } else { %> <%= t('Dữ liệu chưa được đồng bộ từ AD: danh sách máy và key có thể trống hoặc chưa đầy đủ.') %> <% } %> <%= t('Nếu cần key gấp mà không tìm thấy, liên hệ Admin HQ.') %> </div>
<% } %>

<% if (sync && (sync.workerOfflineSince || sync.problemSince || sync.highAlerts || sync.openAlerts || sync.dataAlerts)) { %>
  <a class="notice notice-<%= sync.workerOfflineSince || sync.highAlerts ? 'error' : 'warn' %> block-link" href="/admin/sync">
    <% if (sync.workerOfflineSince) { %><strong><%= t('Worker đang Offline') %></strong> <%= t('từ {at}', { at: h.dateTime(sync.workerOfflineSince) }) %> · <% } %>
    <% if (sync.problemSince) { %><strong><%= t('Đồng bộ AD có sự cố') %></strong> <%= t('từ {at}', { at: h.dateTime(sync.problemSince) }) %> · <% } %>
    <% if (sync.dataAlerts) { %><strong><%= t('{dataAlerts} cảnh báo dữ liệu', { dataAlerts: sync.dataAlerts }) %></strong> <%= t('(nhẹ)') %> · <% } %>
    <% if (sync.openAlerts) { %><strong><%= t('{openAlerts} sự cố sync đang mở', { openAlerts: sync.openAlerts }) %></strong><% if (sync.highAlerts) { %> <%= t('({n} mức cao)', { n: sync.highAlerts }) %><% } %> · <% } %><%= t('xem chi tiết →') %>
  </a>
<% } %>

<section class="tiles">
  <div class="tile">
    <div class="tile-label"><%= t('Máy được giám sát') %></div>
    <div class="tile-value"><%= h.number(totals.computers) %></div>
  </div>
  <div class="tile">
    <div class="tile-label"><%= t('Đã có key trên AD') %></div>
    <div class="tile-value"><%= totals.coveragePct === null ? '—' : `${h.number(totals.coveragePct)}%` %></div>
    <div class="tile-sub"><%= t('{noKey} máy chưa có key', { noKey: h.number(totals.noKey) }) %></div>
  </div>
  <% if (activity) { %>
  <div class="tile">
    <div class="tile-label"><%= t('Lượt hiện key 7 ngày') %></div>
    <div class="tile-value"><%= h.number(activity.reveals7d) %></div>
    <div class="tile-sub"><%= t('hôm nay {today}', { today: h.number(activity.today) }) %></div>
  </div>
  <% } %>
  <% if (sync) { %>
  <div class="tile">
    <div class="tile-label"><%= t('Sync AD thành công gần nhất') %></div>
    <div class="tile-value tile-value-sm"><%= sync.lastSuccessAt ? h.dateTime(sync.lastSuccessAt) : t('Chưa có') %></div>
    <div class="tile-sub">heartbeat: <%= sync.lastHeartbeatAt ? h.dateTime(sync.lastHeartbeatAt) : t('chưa có') %></div>
  </div>
  <% } %>
</section>

<section class="two-col">
  <div class="card">
    <h2><%= t('Số máy trên hệ thống, {length} ngày gần nhất', { length: inventoryDaily.length }) %></h2>
    <p class="chart-now"><%- th('Hiện tại <strong>{value}</strong> máy', { value: h.number(charts.computers.last?.value ?? 0) }) %></p>
    <%- include('partials/line-chart', { chart: charts.computers, label: t('Số máy trên hệ thống theo ngày'), cls: 'series-1' }) %>
  </div>
  <div class="card">
    <h2><%= t('Số key trên hệ thống, {length} ngày gần nhất', { length: inventoryDaily.length }) %></h2>
    <p class="chart-now"><%- th('Hiện tại <strong>{value}</strong> key', { value: h.number(charts.keys.last?.value ?? 0) }) %></p>
    <%- include('partials/line-chart', { chart: charts.keys, label: t('Số key trên hệ thống theo ngày'), cls: 'series-2' }) %>
  </div>
</section>
<p class="muted small chart-note"><%= t('Máy được tính từ ngày hệ thống ghi nhận đến khi bị gắn nhãn "Không còn trong phạm vi giám sát"; key được tính từ ngày ghi nhận. Rê chuột lên biểu đồ để xem số từng ngày.') %></p>

<% if (charts.reveals) { %>
<section class="card">
  <h2><%= t('Lượt hiện key mỗi ngày, 14 ngày gần nhất') %></h2>
  <%- include('partials/line-chart', { chart: charts.reveals, label: t('Lượt hiện key mỗi ngày trong 14 ngày gần nhất'), cls: 'series-1' }) %>
</section>
<% } %>

<section class="card" id="branches">
  <div class="title-row">
    <h2><%= t('Theo chi nhánh') %></h2>
    <span class="muted small">
      <% if (branches.length > branchLimit && !allBranches) { %><%= t('Top {limit} / {total} chi nhánh, nhiều máy nhất', { limit: branchLimit, total: branches.length }) %><% } else { %><%= t('{n} chi nhánh', { n: branches.length }) %><% } %>
    </span>
  </div>
  <% const shown = allBranches ? branches : branches.slice(0, branchLimit); %>
  <div class="hbar-legend" aria-hidden="true"><%- th('<span><i class="hbar-ok"></i>Có key</span><span><i class="hbar-bad"></i>Chưa có key</span>') %></div>
  <% if (!branches.length) { %><p class="muted"><%= t('Chưa có máy nào trong phạm vi của bạn.') %></p><% } else { %>
  <%- include('partials/branch-bars', { rows: shown,
        total: branches.length > 1 ? { computers: totals.computers, with_key: totals.withKey, no_key: totals.noKey } : null }) %>
  <% } %>
  <details class="table-view">
    <summary><%= t('Xem bảng số liệu') %></summary>
    <table class="dense">
      <thead>
        <tr><th><%= t('Chi nhánh') %></th><th class="num"><%= t('Máy') %></th><th class="num"><%= t('Có key') %></th><th class="num"><%= t('Chưa có key') %></th><th class="num"><%= t('Số key') %></th>
          <% if (activity) { %><th class="num"><%= t('Hiện key 30 ngày') %></th><% } %></tr>
      </thead>
      <tbody>
      <% (allBranches ? branches : branches.slice(0, branchLimit)).forEach((b) => { %>
        <tr>
          <td title="<%= b.branch_name ?? t('Máy chưa thuộc chi nhánh nào') %>"><strong><%= h.branchCode(b.branch_code) %></strong><% if (b.branch_name) { %> <span class="muted">· <%= b.branch_name %></span><% } %></td>
          <td class="num"><%= h.number(b.computers) %></td>
          <td class="num"><%= h.number(b.with_key) %></td>
          <td class="num"><% if (b.no_key) { %><a href="/?branchId=<%= b.branch_id ?? 'na' %>&status=no_key"><%= h.number(b.no_key) %></a><% } else { %>—<% } %></td>
          <td class="num"><%= h.number(b.keys) %></td>
          <% if (activity) { %><td class="num"><%= h.number(b.reveals_30d) %></td><% } %>
        </tr>
      <% }) %>
      <% if (!branches.length) { %><tr><td colspan="6" class="muted"><%= t('Chưa có máy nào trong phạm vi của bạn.') %></td></tr><% } %>
      </tbody>
      <% if (branches.length > 1) { %>
      <tfoot>
        <tr>
          <th><%= t('Tổng') %></th>
          <th class="num"><%= h.number(totals.computers) %></th>
          <th class="num"><%= h.number(totals.withKey) %></th>
          <th class="num"><%= h.number(totals.noKey) %></th>
          <th class="num"><%= h.number(totals.keys) %></th>
          <% if (activity) { %><th class="num"><%= h.number(branches.reduce((s, b) => s + (b.reveals_30d ?? 0), 0)) %></th><% } %>
        </tr>
      </tfoot>
      <% } %>
    </table>
    </details>
  <% if (branches.length > branchLimit) { %>
    <p class="more-link">
      <% if (allBranches) { %><a href="/dashboard#branches"><%= t('Thu gọn (top {branchLimit})', { branchLimit: branchLimit }) %></a>
      <% } else { %><a href="/dashboard?branches=all#branches"><%= t('Xem tất cả {length} chi nhánh →', { length: branches.length }) %></a><% } %>
    </p>
  <% } %>
  <p class="muted small"><%= t('Mỗi thanh là toàn bộ máy của chi nhánh. Rê chuột lên thanh để xem số máy; bấm phần đỏ để mở danh sách máy chưa có key.') %></p>
</section>

<section>
  <% if (activity) { %>
  <div class="card">
    <h2><%= t('Xem key nhiều nhất, 7 ngày') %></h2>
    <table class="dense">
      <thead><tr><th><%= t('Người dùng') %></th><th class="num"><%= t('Lượt hiện key') %></th><th><%= t('Gần nhất') %></th></tr></thead>
      <tbody>
      <% activity.top.forEach((u) => { %>
        <tr><td><%= u.user_upn %></td><td class="num"><%= u.reveals %></td><td><%= h.dateTime(u.last_at) %></td></tr>
      <% }) %>
      <% if (!activity.top.length) { %><tr><td colspan="3" class="muted"><%= t('Chưa có lượt xem key nào.') %></td></tr><% } %>
      </tbody>
    </table>
    <% if (can('logs')) { %><p><%- th('<a href="/audit?action=reveal">Xem nhật ký hiện key →</a>') %></p><% } %>
  </div>
  <% } %>
</section>
<%- include('partials/foot') %>
