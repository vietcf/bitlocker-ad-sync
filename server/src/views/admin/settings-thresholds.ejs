<%- include('../partials/head') %>
<%- include('_tabs') %>
<% const UNIT = { percent: '%', minutes: 'phút', hours: 'giờ', months: 'tháng', days: 'ngày', count: '', points: 'điểm %' }; %>
<% const GROUPS = [
  ['run', 'Kiểm tra khi lượt sync kết thúc', 'Vượt ngưỡng thì lượt sync bị giữ lại (cách ly) và chờ Admin HQ chấp nhận hoặc bác bỏ ở tab Tình trạng sync. Các ngưỡng này chỉ xét lượt full (lượt delta chỉ đọc máy và key có thay đổi nên không so với toàn hệ thống).'],
  ['watchdog', 'Sự cố hệ thống (watchdog)', 'Đo trực tiếp, tự hết khi sửa xong, không tắt được. Không có heartbeat thì Worker Offline (một mail); worker vẫn chạy mà vượt ngưỡng khác (không đọc được AD, lâu không có lượt sync, canary, USN...) thì Đồng bộ AD có sự cố (một mail).'],
]; %>
<section class="card">
  <h2>Cảnh báo sync</h2>
  <p class="muted">Ngưỡng và bật/tắt các cảnh báo của đồng bộ AD. Thay đổi có hiệu lực trong vòng 30 giây và được ghi vào nhật ký. Cột "Mặc định" là giá trị khi cài đặt.</p>
  <div class="notice notice-info">
    <strong>Cách các ngưỡng kết hợp</strong>
    <ul>
      <li><strong>Các ngưỡng độc lập với nhau (HOẶC):</strong> chỉ cần <em>một</em> ngưỡng bị vượt là lượt sync bị giữ lại
        (hoặc mở cảnh báo). Nhiều ngưỡng cùng vượt thì liệt kê đủ các lý do.</li>
      <li><strong>Các ngưỡng nằm chung một khung viền xanh (VÀ)</strong>: phải vượt <em>cả hai</em> mới tính.
        Ngưỡng thứ hai để tránh báo nhầm khi số lượng quá nhỏ.<br>
        Ví dụ "chi nhánh giảm quá 20% <strong>và</strong> quá 10 máy": chi nhánh 30 máy còn 20 (giảm 33% nhưng chỉ 10 máy) thì
        không bị giữ; chi nhánh 100 máy còn 75 (giảm 25% và 25 máy) thì bị giữ.</li>
      <li>"Quá" nghĩa là lớn hơn hẳn: ngưỡng 20% thì giảm đúng 20% chưa tính.</li>
    </ul>
  </div>
  <%- include('../partials/error-box', { error }) %>
  <form method="post" action="/admin/settings/thresholds" class="form">
    <%- include('../partials/csrf') %>
    <% GROUPS.forEach(([group, title, help]) => { %>
      <fieldset>
        <legend><%= title %></legend>
        <p class="muted small"><%= help %></p>
        <%- include('_threshold-rows', { items: list.filter((t) => t.group === group), values, UNIT }) %>
      </fieldset>
    <% }) %>

    <fieldset>
      <legend>Cảnh báo dữ liệu (bật/tắt được)</legend>
      <p class="muted small">Tính từ nội dung đã đồng bộ nên còn đúng nhiều ngày sau khi sửa nguyên nhân; không làm dừng sync. Mỗi loại có công tắc bật/tắt và ngưỡng riêng. Tắt thì không bao giờ mở cảnh báo đó (đang mở thì đóng). Nút "Đã xử lý" / "Bỏ qua" ở tab Tình trạng sync chỉ im lặng tạm thời.</p>
      <% alerts.forEach((a) => { %>
        <div class="alert-config">
          <div class="alert-config-head">
            <strong><%= a.label %></strong>
            <%# Cong tac: o an "off" di truoc de form luon gui gia tri (checkbox bo chon thi khong gui gi) %>
            <% const v = Array.isArray(values[a.key]) ? values[a.key].at(-1) : values[a.key]; const on = (v ?? a.enabled) !== false && v !== 'off'; %>
            <input type="hidden" name="<%= a.key %>" value="off">
            <label class="switch" for="<%= a.key %>">
              <input id="<%= a.key %>" type="checkbox" role="switch" name="<%= a.key %>" value="on" <%= on ? 'checked' : '' %> aria-label="Bật hoặc tắt: <%= a.label %>">
              <span class="switch-track" aria-hidden="true"></span>
              <span class="switch-text" aria-hidden="true"></span>
            </label>
          </div>
          <p class="muted small"><%= a.help %></p>
          <% const own = list.filter((t) => t.alert === a.type); if (own.length) { %>
            <%- include('_threshold-rows', { items: own, values, UNIT }) %>
          <% } %>
        </div>
      <% }) %>
      <%- include('_threshold-rows', { items: list.filter((t) => t.group === 'dataalerts' && !t.alert), values, UNIT }) %>
    </fieldset>

    <fieldset>
      <legend>Nhãn hoạt động của máy (không phải cảnh báo)</legend>
      <p class="muted small">Nhãn "Hoạt động gần đây" / "Không hoạt động gần đây" ở trang máy, danh sách Tìm máy và Báo cáo, theo lần đăng nhập AD gần nhất của máy (lastLogonTimestamp, lệch tối đa ~14 ngày). Không tạo cảnh báo. Bộ lọc ở Tìm máy có các mốc riêng (1/3/6/9/12/24 tháng).</p>
      <%- include('_threshold-rows', { items: list.filter((t) => t.group === 'activity'), values, UNIT }) %>
    </fieldset>
    <div class="actions"><button type="submit">Lưu</button></div>
  </form>
</section>
<%- include('../partials/foot') %>
