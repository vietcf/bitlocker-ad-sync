<%# Thanh tab cua khu Quan tri, o dau moi trang quan tri: 4 nhom, nhom dang mo hien cac tab con. Nhan co dinh. %>
<% const groups = [
  [t('Người dùng & chi nhánh'), [
    ['/admin/branches', t('Chi nhánh & OU')],
    ['/admin/users', t('Người dùng')],
  ]],
  [t('Đồng bộ AD'), [
    ['/admin/sync', t('Tình trạng sync')],
    ['/admin/settings/thresholds', t('Cảnh báo sync')],
  ]],
  ['Email', [
    ['/admin/settings/notifications', t('Thông báo')],
    ['/admin/settings/mail-server', 'Mail server'],
    ['/admin/mail', 'Log email'],
  ]],
  [t('Hệ thống'), [
    ['/admin/settings/security', t('Bảo mật')],
    ['/admin/backup', t('Sao lưu')],
    ['/admin/settings/features', t('Tính năng')],
    ['/admin/settings/retention', t('Lưu trữ')],
  ]],
];
  const isOn = (href) => path === href || path.startsWith(`${href}/`);
  const current = groups.find(([, tabs]) => tabs.some(([href]) => isOn(href))) ?? groups[0]; %>
<div class="admin-head">
  <h1><%= t('Quản trị') %></h1>
  <nav class="admin-groups" aria-label="<%= t('Quản trị') %>">
    <% groups.forEach((g) => { %>
      <a href="<%= g[1][0][0] %>" <%- g === current ? 'aria-current="true"' : '' %>><%= g[0] %></a>
    <% }) %>
  </nav>
  <nav class="admin-tabs" aria-label="<%= current[0] %>">
    <% current[1].forEach(([href, label]) => { %>
      <a href="<%= href %>" <%- isOn(href) ? 'aria-current="page"' : '' %>><%= label %></a>
    <% }) %>
  </nav>
</div>
