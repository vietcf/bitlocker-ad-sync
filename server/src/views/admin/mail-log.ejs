<%- include('../partials/head') %>
<%- include('_tabs') %>
<% const STATUS = { pending: [t('Chờ gửi'), 'badge-info'], sent: [t('Đã gửi'), 'badge-good'], failed: [t('Thất bại'), 'badge-bad'], no_recipient: [t('Không gửi (thiếu email)'), 'badge-warn'] }; %>
<% const KIND = { alert: t('Cảnh báo'), new_objects: t('Máy/key mới'), daily_report: t('Báo cáo hằng ngày'), test: t('Thử') }; %>
<section class="card">
  <div class="title-row"><h2>Log email</h2></div>
  <div class="stat-row"> <%- th('<span class="badge badge-info">Chờ gửi: {pending}</span> <span class="badge badge-good">Đã gửi: {sent}</span> <span class="badge badge-bad">Thất bại: {failed}</span> <span class="badge badge-warn">Không gửi (thiếu email): {noRecipient}</span>', { pending: h.number(log.counts.pending ?? 0), sent: h.number(log.counts.sent ?? 0), failed: h.number(log.counts.failed ?? 0), noRecipient: h.number(log.counts.no_recipient ?? 0) }) %> </div>
  <p class="muted small"><%- th('Email đã gửi hoặc thất bại được giữ {retentionDays} ngày (đổi ở tab <a href="/admin/settings/retention">Lưu trữ</a>). Job gửi mail chạy mỗi phút. Lỗi tạm thời được thử lại sau 1, 5, 15, 60 và 240 phút; sau đó mail bị đánh dấu thất bại. Khi Mail server chưa bật, email nằm ở <strong>Chờ gửi</strong> và tự gửi khi bật. Người dùng lẽ ra nhận email nhưng chưa có địa chỉ email được liệt kê ở cột Người nhận (dòng "Không có email"); email không gửi được cho ai được ghi là <strong>Không gửi (thiếu email)</strong>, kèm lý do. Thêm email ở tab <a href="/admin/users">Người dùng</a>.', { retentionDays: log.retentionDays }) %></p>

  <form method="get" action="/admin/mail" class="filter-bar" data-autosubmit>
    <div class="filter-fields">
    <label><%= t('Trạng thái') %> <select name="status">
        <option value=""><%= t('Tất cả') %></option>
        <% Object.entries(STATUS).forEach(([k, [label]]) => { %><option value="<%= k %>" <%= log.filters.status === k ? 'selected' : '' %>><%= label %></option><% }) %>
      </select>
    </label>
    <label class="grow"><%= t('Tìm theo tiêu đề / người nhận / tên người dùng') %> <input name="q" value="<%= log.filters.q %>" maxlength="100"></label>
    </div>
  <div class="filter-actions">
    <span class="spacer"></span>
    <a href="/admin/mail" class="small"><%= t('Xóa lọc') %></a>
    <button type="submit" class="small"><%= t('Lọc') %></button>
  </div>
  </form>

  <table>
    <thead><tr><th>#</th><th><%= t('Tạo lúc') %></th><th><%= t('Loại') %></th><th><%= t('Người nhận') %></th><th><%= t('Tiêu đề') %></th><th><%= t('Trạng thái') %></th><th><%= t('Gửi lúc') %></th></tr></thead>
    <tbody>
    <% log.rows.forEach((m) => { const st = STATUS[m.status]; %>
      <tr>
        <td><a href="/admin/mail/<%= m.id %>"><%= m.id %></a></td>
        <td><%= h.dateTime(m.created_at) %></td>
        <td><%= KIND[m.kind] ?? m.kind %></td>
        <td class="small"><% if (!m.recipients.length) { %><span class="muted">—</span><% } %><%= m.recipients.slice(0, 3).join(', ') %><% if (m.recipients.length > 3) { %> <span class="muted">+<%= m.recipients.length - 3 %></span><% } %>
          <% if (m.missing_recipients.length) { %><br><span class="warn-text" title="<%= t('Người dùng lẽ ra nhận nhưng chưa có email') %>"><%= t('Không có email: {join}', { join: m.missing_recipients.join(', ') }) %></span><% } %></td>
        <td><a href="/admin/mail/<%= m.id %>"><%= m.subject %></a></td>
        <td><span class="badge <%= st[1] %>"><%= st[0] %></span>
          <% if (m.last_error) { %><br><span class="muted small" title="<%= m.last_error %>"><%= m.last_error.slice(0, 60) %></span><% } %></td>
        <td><%= h.dateTime(m.sent_at) %></td>
      </tr>
    <% }) %>
    <% if (!log.rows.length) { %><tr><td colspan="7" class="muted"><%= t('Chưa có email nào.') %></td></tr><% } %>
    </tbody>
  </table>
  <%- include('../partials/pager', { page: log.page, pages: log.pages, query, total: log.total, pageSize: log.pageSize, unit: 'email' }) %>
</section>

<%- include('../partials/foot') %>
