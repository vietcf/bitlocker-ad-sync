<%- include('../partials/head') %>
<%- include('_tabs') %>
<h2>Tình trạng sync AD</h2>

<% const SUMMARY = ['worker_offline', 'sync_problem', 'sync_offline'];
   const workerOff = openAlerts.find((a) => a.type === 'worker_offline');
   const problem = openAlerts.find((a) => a.type === 'sync_problem');
   const DATA = ['escrow_broken', 'no_key_rising', 'full_stale', 'dc_cert_expiring'];
   const sysAlerts = openAlerts.filter((a) => !SUMMARY.includes(a.type) && !DATA.includes(a.type)); // loi do truc tiep
   const dataAlerts = openAlerts.filter((a) => DATA.includes(a.type) && !a.silenced); // canh bao theo du lieu, chua xu ly
   const nSilenced = openAlerts.filter((a) => a.silenced).length; %>
<%# Hai trang thai rieng: worker (agent) va AD / dong bo %>
<div class="status-pair">
  <div class="status-box <%= workerOff ? 'is-bad' : 'is-ok' %>">
    <div class="status-title">Worker (agent)</div>
    <% if (workerOff) { %><span class="badge badge-bad">● Offline</span> từ <%= h.dateTime(workerOff.opened_at) %>
      <div class="muted small">Không có heartbeat quá <%= heartbeatMax %> phút: sự cố của worker hoặc đường truyền tới app, chưa nói gì về AD.
        Mail gửi khi chuyển sang Offline, sau đó tối đa 1 lần mỗi ngày<% if (workerOff.last_notified_at) { %> (gần nhất <%= h.dateTime(workerOff.last_notified_at) %>)<% } %>; worker gửi heartbeat trở lại thì tự về Online, không gửi nữa.</div>
    <% } else { %><span class="badge badge-good">● Online</span>
      <div class="muted small">Có heartbeat trong <%= heartbeatMax %> phút gần nhất.</div><% } %>
  </div>
  <div class="status-box <%= workerOff ? 'is-unknown' : (sysAlerts.length ? 'is-bad' : (dataAlerts.length ? 'is-warn' : 'is-ok')) %>">
    <div class="status-title">Đồng bộ AD</div>
    <% if (workerOff) { %><span class="badge badge-muted">Chưa xác định</span>
      <div class="muted small">Worker đang Offline nên chưa kiểm tra được AD.</div>
    <% } else { %>
      <div class="status-row"><span class="status-label">Sự cố hệ thống</span>
        <% if (sysAlerts.length) { %><span class="badge badge-bad">● Có sự cố</span><span class="muted small"><%= sysAlerts.map((x) => x.detail.subject).join('; ') %></span>
        <% } else { %><span class="badge badge-good">● OK</span><% } %>
      </div>
      <div class="status-row"><span class="status-label">Cảnh báo dữ liệu</span>
        <% if (dataAlerts.length) { %><span class="badge badge-warn">● Có cảnh báo nhẹ</span><span class="muted small"><%= dataAlerts.map((x) => x.detail.subject).join('; ') %></span>
        <% } else { %><span class="badge badge-good">● OK</span><% if (nSilenced) { %><span class="muted small">(<%= nSilenced %> đã xử lý / bỏ qua)</span><% } %><% } %>
        <% if (alertsOff.length) { %><span class="muted small">Đã tắt <%= alertsOff.length %> loại cảnh báo (Đồng bộ AD > Cảnh báo sync).</span><% } %>
      </div>
      <div class="muted small" style="margin-top:6px">Sự cố hệ thống: worker không đọc được AD, sync quá hạn... (tự hết khi sửa xong). Cảnh báo dữ liệu: tính từ nội dung đã đồng bộ, ví dụ máy mới không có key (không làm dừng sync, cần người vận hành xem và bấm Đã xử lý / Bỏ qua).
        <% if (problem) { %>Mail gửi khi bắt đầu, sau đó tối đa 1 lần mỗi ngày<% if (problem.last_notified_at) { %> (gần nhất <%= h.dateTime(problem.last_notified_at) %>)<% } %>; hết thì tự về bình thường, không gửi nữa.<% } else { %>Watchdog kiểm tra 5 phút một lần.<% } %></div>
    <% } %>
  </div>
</div>
<% if (openAlerts.some((a) => !SUMMARY.includes(a.type))) { %>
<section class="card">
  <h2>Cảnh báo đang mở</h2>
  <% openAlerts.filter((a) => !SUMMARY.includes(a.type)).forEach((a) => { const data = ['escrow_broken', 'no_key_rising', 'full_stale', 'dc_cert_expiring'].includes(a.type); %>
    <div class="notice notice-<%= a.silenced ? 'info' : (a.severity === 'high' ? 'error' : 'warn') %>">
      <strong><%= a.detail.subject %></strong> <span class="muted">· từ <%= h.dateTime(a.opened_at) %></span>
      <% if (a.silenced) { %><span class="badge badge-muted"><%= a.acked_at ? 'Đã xử lý, báo lại sau ' : 'Bỏ qua đến ' %><%= h.dateTime(a.snoozed_until) %></span><% } %>
      <div class="pre"><%= a.detail.text %></div>
      <% if (data && a.acked_by && a.silenced) { %><div class="muted small">Đã <%= a.acked_at ? 'xử lý' : 'bỏ qua' %> bởi <%= a.acked_by %><% if (a.acked_at) { %> lúc <%= h.dateTime(a.acked_at) %><% } %><% if (a.ack_note) { %>: <%= a.ack_note %><% } %></div><% } %>
      <% if (data && !a.silenced) { %>
      <form method="post" class="alert-form">
        <%- include('../partials/csrf') %>
        <input type="text" name="note" maxlength="300" placeholder="Ghi chú (tùy chọn)" aria-label="Ghi chú">
        <div class="alert-form-actions">
          <button type="submit" formaction="/admin/sync/alerts/<%= a.id %>/ack" class="small" title="Đã xử lý nguyên nhân: ngừng gửi mail và không tính vào trạng thái, báo lại nếu hết thời hạn mà điều kiện còn">Đã xử lý</button>
          <span class="alert-form-or">hoặc</span>
          <span class="alert-form-snooze">
            <select name="days" aria-label="Số ngày bỏ qua"><option value="1">1 ngày</option><option value="7" selected>7 ngày</option><option value="30">30 ngày</option></select>
            <button type="submit" formaction="/admin/sync/alerts/<%= a.id %>/snooze" class="small secondary" title="Im lặng trong thời gian chọn; hết hạn mà điều kiện còn thì báo lại">Bỏ qua</button>
          </span>
        </div>
      </form>
      <% } %>
    </div>
  <% }) %>
  <p class="muted small"><strong>Đã xử lý</strong> (cảnh báo tính từ dữ liệu: máy mới không có key, tỉ lệ không key tăng, full sync quá hạn, chứng chỉ DC sắp hết hạn): ngừng gửi mail và không tính vào trạng thái trong thời hạn cấu hình (mặc định 30 ngày, Ngưỡng cảnh báo); hết hạn mà điều kiện còn thì báo lại, điều kiện hết thì cảnh báo tự đóng. <strong>Bỏ qua</strong> im lặng trong 1/7/30 ngày theo cùng cách. Muốn tắt hẳn một loại cảnh báo dữ liệu: Đồng bộ AD > Cảnh báo sync. Sự cố hệ thống (worker, đọc AD, lượt sync, canary, USN) tự hết khi sửa xong nên không cần xác nhận. Mọi thao tác ghi vào nhật ký truy cập.</p>
</section>
<% } %>

<% if (duplicates.length) { %>
<section class="card">
  <h2>Key ID trùng giữa nhiều máy (<%= duplicates.length %>)</h2>
  <p class="muted small">Cùng một Key ID nằm dưới 2 máy đều còn trong phạm vi giám sát (ví dụ máy clone từ image đã bật BitLocker), hoặc cùng Key ID nhưng mật khẩu khác.
    Key vẫn giữ ở máy đang giữ, không bị ghi đè. Không ảnh hưởng trạng thái Online / Offline. Tự đóng khi một trong hai máy rời phạm vi giám sát.</p>
  <div class="table-scroll">
  <table class="dense">
    <thead><tr><th>Key ID</th><th>Máy đang giữ key</th><th>Máy cũng có Key ID này</th><th>Mật khẩu</th><th>Ngày tạo trên AD</th><th>Phát hiện</th><th></th></tr></thead>
    <tbody>
    <% duplicates.forEach((d) => { %>
      <tr>
        <td><code><%= d.key_id.slice(0, 8).toUpperCase() %>…</code></td>
        <td><a href="/computers/<%= d.owner_id %>"><%= d.owner_name %></a><br><span class="guid"><%= d.owner_guid %></span></td>
        <td><a href="/computers/<%= d.other_id %>"><%= d.other_name %></a><br><span class="guid"><%= d.other_guid %></span></td>
        <td><% if (d.same_password) { %>giống nhau<% } else { %><span class="badge badge-bad">khác nhau</span><% } %></td>
        <td class="small"><%= d.owner_name %>: <%= d.owner_created ? h.dateTime(d.owner_created) : "không rõ" %><br><%= d.other_name %>: <%= d.other_created ? h.dateTime(d.other_created) : "không rõ" %></td>
        <td><%= h.dateTime(d.detected_at) %><% if (d.notified_at) { %><br><span class="muted small">đã gửi mail</span><% } %></td>
        <td>
          <form method="post" action="/admin/sync/key-duplicates/<%= d.id %>/review" class="inline-actions">
            <%- include('../partials/csrf') %>
            <button type="submit" name="action" value="assign" class="small" title="So ngày tạo trên AD: key được gán cho máy tạo sau (cần mật khẩu giống nhau)">Gán cho máy mới hơn</button>
            <button type="submit" name="action" value="share" class="small secondary" title="Key giữ nguyên ở máy đang giữ; trang của cả 2 máy hiện ghi chú dùng chung">Dùng chung 2 máy</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
  </div>
  <p class="muted small"><strong>Gán cho máy mới hơn:</strong> so ngày tạo (whenCreated) của 2 máy trên AD. Máy tạo sau là máy hiện tại (thường do unjoin rồi join lại, hoặc cài lại Windows), key được gán sang máy đó; máy cũ không bị xóa và vẫn xem được lịch sử chuyển key. Không thực hiện (cặp vẫn mở) nếu mật khẩu 2 máy khác nhau, thiếu ngày tạo, hoặc máy đang giữ key đã là máy mới hơn.<br>
    <strong>Dùng chung 2 máy:</strong> key giữ nguyên ở máy đang giữ, không đổi quyền xem; trang của cả 2 máy hiện ghi chú "Key ID dùng chung với máy X". Dùng khi 2 máy cố ý dùng chung key (ví dụ clone image).<br>
    Cả hai lựa chọn đóng cảnh báo cho cặp này và được ghi vào nhật ký truy cập.</p>
</section>
<% } %>

<section class="card two-col">
  <div>
    <h2>Worker</h2>
    <% if (!heartbeats.length) { %>
      <p class="muted">Chưa nhận heartbeat nào từ sync worker.</p>
    <% } %>
    <% heartbeats.forEach((hb) => { %>
      <dl class="facts">
        <dt>Worker</dt><dd><%= hb.worker_id %> <span class="muted">v<%= hb.version ?? '?' %></span>
          <% if (hb.online) { %><span class="badge badge-good" title="Có heartbeat trong <%= heartbeatMax %> phút gần nhất">● Online</span>
          <% } else { %><span class="badge badge-bad" title="Không có heartbeat quá <%= heartbeatMax %> phút">● Offline</span><% } %></dd>
        <dt>Heartbeat</dt><dd><%= h.dateTime(hb.at) %> <span class="muted">(<%= hb.minutesAgo < 1 ? 'vừa xong' : `${h.number(hb.minutesAgo)} phút trước` %>)</span></dd>
        <dt>DC</dt><dd><%= hb.dc_name ?? '—' %></dd>
        <dt>LDAP</dt><dd><%= hb.ldap_ok === false ? `Lỗi: ${hb.last_error_code ?? ''}` : hb.ldap_ok ? 'OK' : '—' %></dd>
        <dt>Hàng đợi</dt><dd><%= hb.queue_len ?? '—' %></dd>
        <dt>Cert DC hết hạn</dt><dd><%= h.date(hb.dc_cert_expires_at) %></dd>
        <dt>Canary</dt><dd><%= h.dateTime(hb.canary_value) %></dd>
      </dl>
    <% }) %>
  </div>
  <div>
    <h2>Chạy sync ngay</h2>
    <p class="muted">Worker nhận yêu cầu ở lần heartbeat tới (tối đa ~5 phút).
      <% if (requested) { %><br>Đang chờ: <strong><%= requested.mode %></strong> (<%= requested.by %>, <%= h.dateTime(requested.at) %>)<% } %></p>
    <% if (features['feature.manual_sync']) { %>
    <form method="post" action="/admin/sync/request" class="actions">
      <%- include('../partials/csrf') %>
      <button type="submit" name="mode" value="delta" class="secondary">Delta</button>
      <button type="submit" name="mode" value="full" class="secondary">Full</button>
    </form>
    <% } else { %>
    <p class="muted">Yêu cầu sync từ web đang tắt (Quản trị &gt; Tính năng).</p>
    <% } %>
    <p class="muted small">Delta (15 phút) thấy máy mới, đổi tên, chuyển OU trong phạm vi và key mới. Máy bị xóa hoặc chuyển ra ngoài phạm vi chỉ được phát hiện ở <strong>full ban đêm</strong>; cần ngay thì bấm Full.</p>
    <p class="muted">Lần sync thành công gần nhất: <%= lastSuccess ? h.dateTime(lastSuccess.finished_at) : 'chưa có' %></p>
  </div>
</section>

<section class="card">
  <h2>Các lượt sync gần đây</h2>
  <table class="dense">
    <thead><tr><th>#</th><th>Bắt đầu</th><th>Kiểu</th><th>DC</th><th>Trạng thái</th><th class="num">Máy</th><th class="num">Key mới</th><th>Ghi chú</th></tr></thead>
    <tbody>
    <% runs.forEach((r) => { const st = h.runStatus(r.status); %>
      <tr>
        <td><a href="/admin/sync/runs/<%= r.id %>" title="Số thứ tự #<%= r.id %>"><%= h.runRef(r) %></a></td>
        <td><%= h.dateTime(r.started_at) %></td>
        <td><%= r.mode %></td>
        <td><%= r.dc_name %></td>
        <td><span class="badge badge-<%= st.tone %>"><%= st.label %></span></td>
        <td class="num"><%= h.number(r.computers_seen) %></td>
        <td class="num"><%= h.number(r.keys_added) %></td>
        <td>
          <% if (r.error_code) { %><code><%= r.error_code %></code><% } %>
          <% if (r.keys_empty_pwd) { %><span class="badge badge-warn"><%= r.keys_empty_pwd %> key rỗng</span><% } %>
          <% if (r.anomalies) { %><ul class="anomalies"><% r.anomalies.forEach((a) => { %><li><%= h.anomalyText(a) %></li><% }) %></ul><% } %>
          <%# Tom tat o day (ke ca sau khi da quyet dinh); chi tiet va nut quyet dinh o trang mo bang ma luot %>
          <% if (r.status === 'quarantined' && !r.ack_decision) { %>
            <div class="run-summary"><strong>Đang chờ quyết định</strong> · bấm mã lượt <a href="/admin/sync/runs/<%= r.id %>"><%= h.runRef(r) %></a> để xem chi tiết và quyết định.</div>
          <% } else if (r.ack_decision) { %>
            <div class="run-summary muted"><%= r.ack_decision === 'accept' ? 'Đã chấp nhận' : 'Đã bác bỏ' %> bởi <%= r.ack_by %><% if (r.ack_at) { %> lúc <%= h.dateTime(r.ack_at) %><% } %></div>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!runs.length) { %><tr><td colspan="8" class="muted">Chưa có lượt sync nào.</td></tr><% } %>
    </tbody>
  </table>
</section>
<%- include('../partials/foot') %>
