<%# Cac dong nguong (gom dong "..." thanh khung VA). Tham so: items (cac nguong), values, UNIT %>
<%
  const units = [];
  items.forEach((row) => {
    if (row.label.startsWith('...') && units.length) units[units.length - 1].push(row);
    else units.push([row]);
  });
%>
<div class="thr-list">
  <div class="thr-row thr-head"><%- th('<span>Ngưỡng</span><span>Giá trị</span><span>Mặc định</span>') %></div>
  <% units.forEach((unit) => { %>
    <% if (unit.length > 1) { %><div class="thr-and" role="group" aria-label="<%= t('Phải vượt cả {length} ngưỡng', { length: unit.length }) %>">
      <span class="thr-and-tag"><%= t('VÀ · phải vượt cả {length} ngưỡng mới tính', { length: unit.length }) %></span><% } %>
    <% unit.forEach((row, i) => { %>
      <% if (i > 0) { %><div class="thr-and-sep"><%- th('<span>và</span>') %></div><% } %>
      <div class="thr-row">
        <label for="<%= row.key %>"><%= t(row.label).replace(/^\.\.\.\s*((?:và|and)\s+)?/, '') %></label>
        <span class="nowrap">
          <input id="<%= row.key %>" name="<%= row.key %>" type="number" value="<%= values[row.key] %>" class="thr-input"
                 min="<%= row.min %>" max="<%= row.max %>" step="<%= row.unit === 'percent' ? '0.1' : '1' %>" required> <%= UNIT[row.unit] %>
        </span>
        <span class="muted"><%= row.defaultValue %> <%= UNIT[row.unit] %></span>
      </div>
    <% }) %>
    <% if (unit.length > 1) { %></div><% } %>
  <% }) %>
</div>
