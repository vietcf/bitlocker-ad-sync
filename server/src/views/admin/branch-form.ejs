<%- include('../partials/head') %>
<%- include('_tabs') %>
<p class="crumbs"><%- th('<a href="/admin/branches">← Chi nhánh</a>') %></p>
<section class="card narrow wide-ish">
  <h2><%= title %></h2>
  <%- include('../partials/error-box', { error }) %>
  <form method="post" action="/admin/branches<%= branchId ? `/${branchId}` : '' %>" class="form">
    <%- include('../partials/csrf') %>
    <label><%= t('Mã chi nhánh') %> <input name="code" value="<%= form.code ?? '' %>" maxlength="16" required placeholder="HN"></label>
    <label><%= t('Tên') %> <input name="name" value="<%= form.name ?? '' %>" maxlength="128" required placeholder="<%= t('Hà Nội') %>"></label>
    <label><%= t('OU gốc') %> <span class="muted"><%= t('(mỗi dòng một DN)') %></span>
      <textarea name="ous" rows="4" spellcheck="false" placeholder="OU=Computers,OU=HN,DC=corp,DC=local"><%= form.ous ?? '' %></textarea>
    </label>
    <label class="check"><input type="checkbox" name="isActive" <%= form.isActive ? 'checked' : '' %>> <%= t('Đang hoạt động') %></label>

    <% if (preview) { %>
      <div class="notice notice-info">
        <% if (!preview.length) { %> <%= t('Các OU này không khớp máy nào.') %> <% } else { %>
          <%= t('Khớp {n} máy, hiện thuộc:', { n: preview.reduce((s, p) => s + p.computers, 0) }) %>
          <% preview.forEach((p) => { %><span class="badge badge-muted"><%= p.current_branch %>: <%= p.computers %></span> <% }) %>
        <% } %>
      </div>
    <% } %>

    <div class="actions">
      <button type="submit" name="intent" value="save"><%= t('Lưu') %></button>
      <button type="submit" name="intent" value="preview" class="secondary"><%= t('Xem trước số máy khớp') %></button>
      <a class="button secondary" href="/admin/branches"><%= t('Hủy') %></a>
    </div>
    <p class="muted"><%= t('Khi lưu, hệ thống quét toàn bộ máy và gán vào chi nhánh theo OU ngay lập tức (không cần chờ lượt sync).') %></p>
  </form>
  <% if (branchId) { %>
    <p class="danger-zone"><%- th('<a class="button danger small" href="/admin/branches/{branchId}/delete">Xóa chi nhánh…</a> <span class="muted small">Máy của chi nhánh chuyển về N/A; cần xác nhận ở bước sau.</span>', { branchId: branchId }) %></p>
  <% } %>
</section>
<%- include('../partials/foot') %>
