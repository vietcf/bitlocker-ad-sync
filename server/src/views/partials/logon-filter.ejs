<%# Hai o loc dang nhap AD gan nhat, dung chung cho Tim may va Bao cao. Tham so: filters { activity, noLogon }; newRow (mac dinh true: xuong dong rieng); bare (chi hai nhan, khong khung: de dat trong khung cua trang goi); activityMonths la local %>
<%
  const act = filters.activity === 'unknown' ? '' : (filters.activity ?? '');
  const noLogon = filters.activity === 'unknown' ? 'only' : (filters.noLogon ?? (act ? 'exclude' : 'include'));
  const months = [...new Set([1, 3, 6, 9, 12, 24, Number(act.slice(1)) || 1, activityMonths])].sort((x, y) => x - y);
%>
<% const isBare = typeof bare !== 'undefined' && bare; %>
<% if (!isBare && (typeof newRow === 'undefined' || newRow)) { %><div class="filter-break"></div><% } %>
<% if (!isBare) { %><div class="logon-range<%= typeof newRow !== 'undefined' && !newRow ? ' logon-inline' : '' %>" role="group" aria-label="<%= t('Đăng nhập AD gần nhất') %>"><% } %>
  <label class="logon-activity" title="<%= t('Theo lần đăng nhập domain gần nhất của máy trên AD (lastLogonTimestamp, lệch tối đa ~14 ngày)') %>"><%= t('Đăng nhập AD gần nhất') %> <select name="activity">
      <option value=""><%= t('Tất cả') %></option>
      <optgroup label="<%= t('Hoạt động gần đây') %>">
        <% months.forEach((n) => { %><option value="a<%= n %>" <%= act === 'a' + n ? 'selected' : '' %>><%= t('Trong {n} tháng gần nhất', { n: n }) %></option><% }) %>
      </optgroup>
      <optgroup label="<%= t('Không hoạt động gần đây') %>">
        <% months.forEach((n) => { %><option value="i<%= n %>" <%= act === 'i' + n ? 'selected' : '' %>><%= t('Quá {n} tháng chưa thấy', { n: n }) %></option><% }) %>
      </optgroup>
    </select>
  </label>
  <label class="logon-nodata" title="<%= t('Máy mà AD chưa ghi lần đăng nhập nào: chưa từng đăng nhập domain, hoặc worker chưa báo dữ liệu này.') %>"><%= t('Máy chưa có dữ liệu') %> <select name="noLogon">
      <option value="exclude" <%= noLogon === 'exclude' ? 'selected' : '' %>><%= t('Không gồm') %></option>
      <option value="include" <%= noLogon === 'include' ? 'selected' : '' %>><%= t('Gồm cả') %></option>
      <option value="only" <%= noLogon === 'only' ? 'selected' : '' %>><%= t('Chỉ máy này') %></option>
    </select>
  </label>
<% if (!isBare) { %></div>
<div class="filter-break"></div><% } %>
