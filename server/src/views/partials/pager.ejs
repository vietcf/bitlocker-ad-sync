<%#
  Pagination. Params: page, pages, query (current query string values), optional total, pageSize, unit, param (name of the page parameter, default "page").
  Shows: first · prev · a window of page numbers · next · last, plus "Showing a–b / total".
%>
<% const size = typeof pageSize !== 'undefined' ? pageSize : null; %>
<% const count = typeof total !== 'undefined' ? total : null; %>
<% const noun = t(typeof unit !== 'undefined' ? unit : 'dòng'); %>
<% const pname = typeof param !== 'undefined' ? param : 'page'; %>
<% if (pages > 1 || (count !== null && size)) { %>
<nav class="pager" aria-label="<%= t('Phân trang') %>">
  <% if (count !== null && size) { %>
    <span class="pager-info">
      <% if (count === 0) { %><%= t('Không có {noun} nào', { noun }) %><% } else { %>
      <%= t('Hiển thị {from}–{to} / {total} {noun}', { from: h.number((page - 1) * size + 1), to: h.number(Math.min(page * size, count)), total: h.number(count), noun }) %><% } %>
    </span>
  <% } %>
  <% if (pages > 1) { %>
    <span class="pager-links">
      <% const win = 2; const from = Math.max(1, page - win); const to = Math.min(pages, page + win); %>
      <% if (page > 1) { %>
        <a href="<%= h.query(query, { [pname]: 1 }) %>" aria-label="<%= t('Trang đầu') %>">«</a>
        <a href="<%= h.query(query, { [pname]: page - 1 }) %>" aria-label="<%= t('Trang trước') %>">‹</a>
      <% } else { %><span class="disabled">«</span><span class="disabled">‹</span><% } %>
      <% if (from > 1) { %><span class="gap">…</span><% } %>
      <% for (let p = from; p <= to; p++) { %>
        <% if (p === page) { %><span class="current" aria-current="page"><%= p %></span>
        <% } else { %><a href="<%= h.query(query, { [pname]: p }) %>"><%= p %></a><% } %>
      <% } %>
      <% if (to < pages) { %><span class="gap">…</span><% } %>
      <% if (page < pages) { %>
        <a href="<%= h.query(query, { [pname]: page + 1 }) %>" aria-label="Trang sau">›</a>
        <a href="<%= h.query(query, { [pname]: pages }) %>" aria-label="<%= t('Trang cuối') %>">»</a>
      <% } else { %><span class="disabled">›</span><span class="disabled">»</span><% } %>
    </span>
  <% } %>
</nav>
<% } %>
