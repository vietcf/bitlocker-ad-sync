<%# Thanh ngang 100% moi chi nhanh: xanh = % may co key, do = % may chua co key.
    Locals: rows (branch_id, branch_code, branch_name, computers, with_key, no_key), total (dong Tong hoac null). %>
<%
  const pct = (n, of) => (of ? (n * 100) / of : 0);
  // Lam tron nhung khong de 0% / 100% khi con may o phan kia
  const fmt = (p) => (p > 0 && p < 1 ? '<1%' : p > 99 && p < 100 ? '>99%' : `${Math.round(p)}%`);
  const bar = (b, isTotal) => {
    const ok = pct(b.with_key, b.computers);
    const bad = pct(b.no_key, b.computers);
    // Do rong theo % nguyen (CSP chan style inline nen dung class .pct-N); phan nho van >= 1%
    let wBad = bad > 0 ? Math.max(1, Math.round(bad)) : 0;
    if (ok > 0 && wBad === 100) wBad = 99;
    return { ok, bad, isTotal, wOk: ok > 0 ? 100 - wBad : 0, wBad };
  };
%>
<ul class="hbars" role="list">
<% [...rows.map((b) => [b, bar(b, false)]), ...(total ? [[total, bar(total, true)]] : [])].forEach(([b, v]) => { %>
  <li class="hbar-row<%= v.isTotal ? ' hbar-total' : '' %>">
    <span class="hbar-label" title="<%= v.isTotal ? t('Tất cả chi nhánh') : (b.branch_name ?? t('Máy chưa thuộc chi nhánh nào')) %>">
      <strong><%= v.isTotal ? t('Tổng') : h.branchCode(b.branch_code) %></strong><% if (!v.isTotal && b.branch_name) { %> <span class="muted">· <%= b.branch_name %></span><% } %>
    </span>
    <span class="hbar" aria-label="<%= t('{n} máy: {ok} có key, {bad} chưa có key', { n: h.number(b.computers), ok: fmt(v.ok), bad: fmt(v.bad) }) %>">
      <% if (!b.computers) { %><span class="hbar-empty"><%= t('Chưa có máy') %></span><% } %>
      <% if (v.ok > 0) { %><span class="hbar-seg hbar-ok pct-<%= v.wOk %>"
        title="<%= t('Có key: {ok} ({withKey}/{computers} máy)', { ok: fmt(v.ok), withKey: h.number(b.with_key), computers: h.number(b.computers) }) %>"><% if (v.ok >= 12) { %><%= fmt(v.ok) %><% } %></span><% } %>
      <% if (v.bad > 0) { %><a class="hbar-seg hbar-bad pct-<%= v.wBad %>"
        href="/?<%= v.isTotal ? '' : `branchId=${b.branch_id ?? 'na'}&` %>status=no_key"
        title="<%= t('Chưa có key: {bad} ({noKey}/{computers} máy), bấm để xem danh sách', { bad: fmt(v.bad), noKey: h.number(b.no_key), computers: h.number(b.computers) }) %>"><% if (v.bad >= 12) { %><%= fmt(v.bad) %><% } %></a><% } %>
    </span>
    <span class="hbar-count"><%= t('{n} máy', { n: h.number(b.computers) }) %><% if (v.ok > 0 && v.ok < 12) { %><br><span class="muted small"><%= t('có key {ok}', { ok: fmt(v.ok) }) %></span><% } %><% if (v.bad > 0 && v.bad < 12) { %><br><span class="muted small"><%= t('chưa có key {bad}', { bad: fmt(v.bad) }) %></span><% } %></span>
  </li>
<% }) %>
</ul>
