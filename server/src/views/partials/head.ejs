<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · BitLocker Keys</title>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body<% if (locals.me && locals.sessionIdleMinutes) { %> data-idle-minutes="<%= sessionIdleMinutes %>"<% } %>>
<% if (me && !me.mustChangePassword) { %>
<header class="topbar">
  <a class="brand" href="/">BitLocker Keys</a>
  <nav class="nav" aria-label="<%= t('Chính') %>">
    <%# Static labels only, so building the tag as a string is safe. %>
    <% const active = (href) => (href === '/' ? path === '/' || path.startsWith('/computers') : path.startsWith(href)); %>
    <% const link = (href, label) => `<a href="${href}"${active(href) ? ' aria-current="page"' : ''}>${label}</a>`; %>
    <% if (can('keys') || can('reports')) { %><%- link('/dashboard', t('Tổng quan')) %><% } %>
    <% if (can('keys')) { %><%- link('/', t('Tìm máy')) %><% } %>
    <% if (can('logs')) { %><%- link('/audit', t('Nhật ký')) %><% } %>
    <% if (can('reports')) { %><%- link('/reports', t('Báo cáo')) %><% } %>
    <% if (can('admin')) { %>
      <%- link('/admin', t('Quản trị')) %>
    <% } %>
  </nav>
  <div class="account">
    <%- include('lang-switch') %>
    <span class="who" title="<%= me.upn %>"><%= me.displayName || me.upn %></span>
    <% if (me.authSource === 'local') { %><a href="/change-password"><%= t('Đổi mật khẩu') %></a><% } %>
    <form method="post" action="/logout" class="inline">
      <%- include('csrf') %>
      <button type="submit" class="link"><%= t('Đăng xuất') %></button>
    </form>
  </div>
</header>
<% } %>
<% if (!(me && !me.mustChangePassword)) { %><div class="lang-corner"><%- include('lang-switch') %></div><% } %>
<main class="page">
<% if (flash) { %>
  <div class="notice notice-<%= flash.type %>" role="status"><%= flash.text %></div>
<% } %>
