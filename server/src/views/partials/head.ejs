<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · BitLocker Keys</title>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/app.js" defer></script>
</head>
<body<% if (locals.me && locals.sessionIdleMinutes) { %> data-idle-minutes="<%= sessionIdleMinutes %>"<% } %>>
<% if (me && !me.mustChangePassword) { %>
<header class="topbar">
  <a class="brand" href="/">BitLocker Keys</a>
  <nav class="nav" aria-label="Chính">
    <%# Static labels only, so building the tag as a string is safe. %>
    <% const active = (href) => (href === '/' ? path === '/' || path.startsWith('/computers') : path.startsWith(href)); %>
    <% const link = (href, label) => `<a href="${href}"${active(href) ? ' aria-current="page"' : ''}>${label}</a>`; %>
    <% if (can('keys') || can('reports')) { %><%- link('/dashboard', 'Tổng quan') %><% } %>
    <% if (can('keys')) { %><%- link('/', 'Tìm máy') %><% } %>
    <% if (can('logs')) { %><%- link('/audit', 'Nhật ký') %><% } %>
    <% if (can('reports')) { %><%- link('/reports', 'Báo cáo') %><% } %>
    <% if (can('admin')) { %>
      <%- link('/admin', 'Quản trị') %>
    <% } %>
  </nav>
  <div class="account">
    <span class="who" title="<%= me.upn %>"><%= me.displayName %></span>
    <% if (me.authSource === 'local') { %><a href="/change-password">Đổi mật khẩu</a><% } %>
    <form method="post" action="/logout" class="inline">
      <%- include('csrf') %>
      <button type="submit" class="link">Đăng xuất</button>
    </form>
  </div>
</header>
<% } %>
<main class="page">
<% if (flash) { %>
  <div class="notice notice-<%= flash.type %>" role="status"><%= flash.text %></div>
<% } %>
