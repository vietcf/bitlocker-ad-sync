<%- include('../partials/head') %>
<p class="crumbs"><%- th('<a href="/computers/{computerId}">← Quay lại máy</a>', { computerId: computerId }) %></p>
<section class="card narrow">
  <h1><%= t('Hiện recovery key') %></h1>
  <p>Key ID: <code><strong><%= keyId.slice(0, 8).toUpperCase() %></strong><%= keyId.slice(8).toUpperCase() %></code></p>
  <p class="muted"><%= t('Lượt xem này được ghi lại (người xem, thời điểm, máy, lý do). Key hiện trong 60 giây. Sau khi người dùng mở được máy, cần xoay key.') %></p>
  <%- include('../partials/error-box', { error }) %>
  <form method="post" action="/computers/<%= computerId %>/keys/<%= keyId %>/reveal" class="form">
    <%- include('../partials/csrf') %>
    <label><%= t('Lý do') %> <select name="reason" required>
        <option value=""><%= t('— Chọn lý do —') %></option>
        <% reasons.forEach((r) => { %>
          <option value="<%= r.value %>" <%= form.reason === r.value ? 'selected' : '' %>><%= t(r.label) %></option>
        <% }) %>
      </select>
    </label>
    <label><%= t('Ghi chú') %> <span class="muted"><%= t('(bắt buộc nếu chọn “Lý do khác”)') %></span>
      <textarea name="reasonNote" maxlength="500" rows="3"><%= form.reasonNote ?? '' %></textarea>
    </label>
    <label><%= t('Số ticket') %> <% if (!ticketRequired) { %><span class="muted"><%= t('(nếu có)') %></span><% } %>
      <input name="ticketNo" maxlength="64" value="<%= form.ticketNo ?? '' %>" <%= ticketRequired ? 'required' : '' %>>
    </label>
    <div class="actions">
      <button type="submit"><%= t('Hiện key') %></button>
      <a class="button secondary" href="/computers/<%= computerId %>"><%= t('Hủy') %></a>
    </div>
  </form>
</section>
<%- include('../partials/foot') %>
